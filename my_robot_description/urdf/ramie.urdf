<?xml version="1.0"?>
<robot name="moje_ramie">

    <material name="szary"> <color rgba="0.5 0.5 0.5 1.0"/> </material>
    <material name="niebieski"> <color rgba="0.0 0.4 0.8 1.0"/> </material>
    <material name="zielony"> <color rgba="0.0 0.8 0.4 1.0"/> </material>
    <material name="czerwony"> <color rgba="0.8 0.2 0.2 1.0"/> </material>

    <link name="base_link" />

    <link name="base">
        <visual>
            <geometry> <cylinder radius="0.1" length="0.05" /> </geometry>
            <origin xyz="0 0 0.025" rpy="0 0 0" />
            <material name="szary" />
        </visual>
        <collision>
            <geometry> <cylinder radius="0.1" length="0.05" /> </geometry>
            <origin xyz="0 0 0.025" rpy="0 0 0" />
        </collision>
        <inertial> <mass value="2.0"/> <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/> </inertial>
    </link>

    <link name="arm">
        <visual>
            <geometry> <cylinder radius="0.04" length="0.4" /> </geometry>
            <origin xyz="0 0 0.2" rpy="0 0 0" />
            <material name="niebieski" />
        </visual>
        <collision>
            <geometry> <cylinder radius="0.04" length="0.4" /> </geometry>
            <origin xyz="0 0 0.2" rpy="0 0 0" />
        </collision>
        <inertial> <mass value="1.0"/> <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/> </inertial>
    </link>

    <link name="forearm">
        <visual>
            <geometry> <cylinder radius="0.03" length="0.3" /> </geometry>
            <origin xyz="0 0 0.15" rpy="0 0 0" />
            <material name="zielony" />
        </visual>
        <collision>
            <geometry> <cylinder radius="0.03" length="0.3" /> </geometry>
            <origin xyz="0 0 0.15" rpy="0 0 0" />
        </collision>
        <inertial> <mass value="0.8"/> <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/> </inertial>
    </link>

    <link name="hand">
        <visual>
            <geometry> <cylinder radius="0.02" length="0.15" /> </geometry>
            <origin xyz="0 0 0.075" rpy="0 0 0" /> <material name="czerwony" />
        </visual>
        <collision>
            <geometry> <cylinder radius="0.02" length="0.15" /> </geometry>
            <origin xyz="0 0 0.075" rpy="0 0 0" />
        </collision>
        <inertial> <mass value="0.3"/> <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/> </inertial>
    </link>


    <joint name="base_joint" type="fixed">
        <parent link="base_link" />
        <child link="base" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <joint name="base_to_arm" type="revolute">
        <parent link="base" />
        <child link="arm" />
        <origin xyz="0 0 0.05" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <limit lower="-3.14" upper="3.14" effort="100" velocity="1.0" />
    </joint>

    <joint name="arm_to_forearm" type="revolute">
        <parent link="arm" />
        <child link="forearm" />
        <origin xyz="0 0 0.4" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit lower="0" upper="2.09" effort="100" velocity="1.0" />
    </joint>

    <joint name="forearm_to_hand" type="revolute">
        <parent link="forearm" />
        <child link="hand" />
        <origin xyz="0 0 0.3" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit lower="-1.57" upper="1.57" effort="100" velocity="1.0" />
    </joint>

</robot>