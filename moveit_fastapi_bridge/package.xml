<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>moveit_fastapi_bridge</name>
  <version>0.0.0</version>
  <description>Most pomiędzy serwerem FastAPI a MoveIt2 Planning Scene</description>
  <maintainer email="marek@todo.todo">Marek Kulma</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- ZALEŻNOŚCI ROS 2 (Runtime) -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>

  <!-- ZALEŻNOŚCI ZEWNĘTRZNE (Python) -->
  <exec_depend>python3-fastapi</exec_depend>
  <exec_depend>python3-uvicorn</exec_depend>
  <exec_depend>python3-pydantic</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>